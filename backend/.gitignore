# backend/.gitignore — Python / FastAPI specific rules
# (root .gitignore handles common patterns)

# Virtual environments
.venv/
venv/
env/

# Secrets
.env
*.pem
*.key

# Python artifacts
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/

# Test & coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Type checker caches
.mypy_cache/
.ruff_cache/
.pytype/

# Uploaded files
uploads/
*.csv

# Logs
*.log
