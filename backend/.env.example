# Veylo Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change-me-generate-a-strong-secret
PUBLIC_BASE_URL=https://veylo-backend.onrender.com
ORG_NAME=Demo Institute

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON array of allowed origins
CORS_ORIGINS=["https://your-app.vercel.app"]
WEB_ORIGIN=https://your-app.vercel.app

# ── Database (Supabase connection pooler recommended) ─────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-generate-a-strong-jwt-secret
DATA_ENC_KEY=                          # base64-encoded 32 bytes for AES-256-GCM
PHONE_HMAC_KEY=                        # base64-encoded 32 bytes for HMAC-SHA256
WEBHOOK_SECRET=change-me-webhook-secret-32chars!!

# ── Exotel Telephony ─────────────────────────────────────────────────────────
CALL_PROVIDER=exotel
EXOTEL_SID=your-exotel-account-sid
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_SUBDOMAIN=api.exotel.com        # or your region subdomain
EXOTEL_CALLER_ID=+91xxxxxxxxxx
EXOTEL_MAX_CONCURRENT=3
WEBHOOK_BASE_URL=https://veylo-backend.onrender.com

# ── AI Service (internal) ─────────────────────────────────────────────────────
AI_BASE_URL=https://veylo-ai.onrender.com
AI_INTERNAL_TOKEN=change-me-generate-a-strong-internal-token

# ── Storage ───────────────────────────────────────────────────────────────────
MEDIA_DIR=/tmp/media
RECORDINGS_DIR=/tmp/recordings

# ── Redis / Celery (optional for background tasks) ───────────────────────────
# REDIS_URL=redis://your-redis-url:6379/0
