# Environment variables for the Veylo backend
# Copy this file to .env and fill in real values.
# NEVER commit the .env file.

# ── App ─────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-strong-random-secret

# ── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# ── Supabase ────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Exotel ──────────────────────────────────────────────────────
EXOTEL_SID=your-exotel-account-sid
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_SUBDOMAIN=your-exotel-subdomain
EXOTEL_CALLER_ID=your-virtual-number

# ── AI Provider ─────────────────────────────────────────────────
AI_PROVIDER=openai          # openai | anthropic | gemini
AI_API_KEY=your-ai-api-key
AI_MODEL=gpt-4o-mini

# ── Webhook ─────────────────────────────────────────────────────
WEBHOOK_BASE_URL=https://your-backend-url.example.com
