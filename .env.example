# .env.example — Veylo PR 002
# Owner: Member 4  |  CONTRACTS.md §11
#
# Copy this file to .env and fill in real values.
# Never commit .env to git.  Mode 600, owned by pr002.
# Run scripts/gen_secrets.sh to generate random values for the secret fields.

# ── Core ──────────────────────────────────────────────────────────────────────
APP_ENV=dev
# dev | prod — controls debug output, CORS strictness, cookie flags

PUBLIC_BASE_URL=https://api.example.com
# Full HTTPS URL served by the host Caddy on port 8100 (no trailing slash)

WEB_ORIGIN=https://app.example.com
# CORS allow-list for the API (the Next.js origin)

DATABASE_URL=postgresql+psycopg://pr002:CHANGE_ME@postgres:5432/pr002
# Postgres DSN — uses the service name "postgres" inside Docker network

REDIS_URL=redis://:CHANGE_ME@redis:6379/0
# Redis DSN — DB 0 for Celery broker; DB 1 used as result backend by Celery

POSTGRES_PASSWORD=CHANGE_ME
# Plain password; used by the postgres service and in DATABASE_URL above

REDIS_PASSWORD=CHANGE_ME
# Plain password; used by the redis service and in REDIS_URL above

JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
# HS256 signing key; generate with: python -c "import secrets; print(secrets.token_hex(32))"

ORG_NAME=Demo Institute
# Spoken in the call greeting as {org_name}

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
# Seeded on first start via the /api/admin seed endpoint

# ── Security ──────────────────────────────────────────────────────────────────
DATA_ENC_KEY=CHANGE_ME_BASE64_32_BYTES
# AES-256-GCM key for phone numbers, names, recording files.
# Generate with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"

PHONE_HMAC_KEY=CHANGE_ME_BASE64_32_BYTES
# HMAC-SHA256 key for phone hash (dedup and lookup).
# Generate same way as DATA_ENC_KEY.

WEBHOOK_SECRET=CHANGE_ME_RANDOM_32_CHARS
# Embedded in the Exotel callback URL path; requests with a wrong secret get 404.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

RECORDING_RETENTION_DAYS=30
# Recordings older than this are purged by the maintenance task

EVENT_RETENTION_DAYS=90
# Call events / audit log older than this are purged

# ── Storage ───────────────────────────────────────────────────────────────────
MEDIA_DIR=/data/media
# Mounted volume for rendered audio assets (publicly served at /media/audio/*)

RECORDINGS_DIR=/data/recordings
# Mounted volume for encrypted call recordings (not publicly served)

# ── Telephony ─────────────────────────────────────────────────────────────────
CALL_PROVIDER=mock
# mock | exotel  — set to "exotel" in production

EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLER_ID=
# Leave blank when CALL_PROVIDER=mock

EXOTEL_MAX_CONCURRENT=3
# Maximum simultaneous outbound calls (Exotel sandbox limit)

# ── AI service ───────────────────────────────────────────────────────────────
AI_BASE_URL=http://ai:8200
# Internal URL for the AI service (not exposed publicly)

AI_INTERNAL_TOKEN=CHANGE_ME_RANDOM_TOKEN
# Shared secret between api/worker and the ai service (X-Internal-Token header)

STT_MODEL=faster-whisper-small
# faster-whisper-small | faster-whisper-medium | indic-conformer

LLM_FALLBACK=none
# gemini | groq | none  — used for translation and intent fallback

GEMINI_API_KEY=
GROQ_API_KEY=
# Required only when LLM_FALLBACK is set to the respective provider

TTS_ENGINE=edge
# edge | parler  — edge uses Microsoft Azure free tier, parler is on-premise

# ── Frontend (Next.js — NEXT_PUBLIC_* is baked into the bundle at build time) ─
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100
# For local dev point to localhost; for production use PUBLIC_BASE_URL value

NEXT_PUBLIC_USE_MOCKS=true
# true = use MSW mock handlers (no real API needed); false = call real API
