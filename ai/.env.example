# ─────────────────────────────────────────────────────────────────────────────
# Veylo AI Service — Environment Variables
# Copy this to .env and fill in your values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Internal service auth ────────────────────────────────────────────────────
# Shared secret between backend and AI service. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AI_INTERNAL_TOKEN=change-me-generate-a-secure-random-string

# ── Service ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8200

# ── Stub mode ─────────────────────────────────────────────────────────────────
# true  → return deterministic fake responses (default; use in dev/CI)
# false → use Sarvam AI APIs (requires SARVAM_API_KEY)
AI_STUB=true

# ── Sarvam AI (PRIMARY PROVIDER) ─────────────────────────────────────────────
# Get your API key at: https://dashboard.sarvam.ai/
# NEVER expose this key in frontend environment variables, logs, or API responses.
SARVAM_API_KEY=

# Model overrides (defaults are recommended)
SARVAM_STT_MODEL=saaras:v4
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TTS_MODEL=bulbul:v2

# Output sample rate for TTS — 8000 Hz for Exotel telephony, 16000 for playback
SARVAM_TTS_SAMPLE_RATE=8000

# ── Exotel audio format ───────────────────────────────────────────────────────
# Exotel delivers recordings as MP3 or WAV (8 kHz, mono) — Sarvam handles both.
# Set to "pcm_s16le" ONLY if Exotel sends raw PCM (rare). Otherwise leave "auto".
EXOTEL_AUDIO_CODEC=auto

# ── Intent classification ─────────────────────────────────────────────────────
INTENT_CONFIDENCE_THRESHOLD=0.6

# Optional LLM fallback when rules give no match (default: none — private by design)
# Options: none | gemini | groq
LLM_FALLBACK=none
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Lexicons ─────────────────────────────────────────────────────────────────
LEXICON_DIR=app/intent/lexicon

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL MODEL WEIGHTS — NOT REQUIRED FOR THIS MVP
# Sarvam AI replaces all local models. No weights need to be downloaded.
# The following are kept for reference only:
#   - faster-whisper (STT) → replaced by Sarvam Saaras v4
#   - IndicTrans2 (translate) → replaced by Sarvam Mayura v1
#   - edge-tts / Bulbul local (TTS) → replaced by Sarvam Bulbul v2
# ─────────────────────────────────────────────────────────────────────────────
