# ═══════════════════════════════════════════════════════════════════════════
# Veylo — Root .gitignore
# ═══════════════════════════════════════════════════════════════════════════

# ── Secrets & environment ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
models/
*.pem
*.key
*.crt

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg
*.egg-info/
dist/
build/
wheels/
.pytest_cache/
.pytest-tmp/
.mypy_cache/
.ruff_cache/
.pytype/
htmlcov/
.coverage
.coverage.*
coverage.xml
nosetests.xml
pip-log.txt
pip-delete-this-directory.txt

# ── Node / Next.js ───────────────────────────────────────────────────────────
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts
.turbo/
.eslintcache

# ── Uploads & user data (NEVER commit contact data) ──────────────────────────
uploads/
*.csv
*.vcf

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Testing / coverage ───────────────────────────────────────────────────────
coverage/
lcov.info
junit.xml
ai/tests/tts_out/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
.cache/
